# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Authorized Telegram Chat ID (or comma-separated list of IDs)
AUTHORIZED_CHAT_ID=your_chat_id_here

# Directory where photos will be stored organized by date
DOWNLOAD_ROOT=./downloads/whiteboard_photos

# Scheduled Synchronization Configuration (Local time in 24h format)
SYNC_HOUR=21
SYNC_MINUTE=0

# Permitted days for automatic synchronization (comma-separated, english or spanish)
# Options: monday, tuesday, wednesday, thursday, friday, saturday, sunday
ALLOWED_DAYS=tuesday,thursday
